{
  "name": "salon_crm",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "start": "concurrently \"npm --prefix backend start\" \"npm --prefix frontend start\"",
    "install-all": "npm --prefix backend install && npm --prefix frontend install",
    "backend:seed": "npm --prefix backend run seed:all",
    "migrate": "npm run backend:seed"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "all": "^0.0.0",
    "mongodb": "^7.2.0"
  }
}
